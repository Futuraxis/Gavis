{
  "languageVersion": "4.1.0",
  "constants": {
    "board_size": 3,
    "win_length": 3,
    "max_pieces": 3
  },
  "queries": {
    "empty_cells": {
      "description": "所有空格子",
      "expr": {
        "query": {"type": "board_cell"},
        "filter": {
          "eq": [{"get": ["$node", "props.occupant"]}, {"const": null}]
        }
      }
    }
  },
  "actions": [
    {
      "id": "place_piece",
      "type": "move",
      "actorKind": "player",
      "actor": {"var": "$env.turn.currentPlayerId"},
      "phases": ["playing"],
      "params": {
        "cell": {
          "type": "node",
          "label": "落子位置",
          "domain": {"ref": "empty_cells"}
        }
      },
      "legal": {"const": true},
      "effectRef": "do_place_and_check",
      "canonicalKey": {"template": "place:{cell.props.x},{cell.props.y}"}
    }
  ],
  "effects": {
    "do_place": {
      "description": "落子 + 记录顺序",
      "params": {"cell": {"type": "node"}, "actor": {"type": "node"}},
      "ops": [
        {"op": "set", "path": "state.nodes.{cell.id}.props.occupant", "value": {"get": ["$actor", "id"]}},
        {"op": "set", "path": "state.env.lastPlacedCell", "value": {"get": ["$cell", "id"]}},
        {"op": "set", "path": "state.env.lastActor", "value": {"get": ["$actor", "id"]}},
        {"op": "inc", "path": "state.env.turn.round", "by": {"const": 1}},
        {
          "op": "listAppend",
          "path": "state.env.pieceOrder.{actor.id}",
          "value": {"get": ["$cell", "id"]}
        }
      ]
    },
    "do_evict_oldest": {
      "description": "FIFO 淘汰最老棋子 (超过 max_pieces 时)",
      "ops": [
        {
          "op": "trimQueue",
          "path": "state.env.pieceOrder.{env.lastActor}",
          "max": {"const": 3}
        }
      ]
    },
    "do_check_winner": {
      "description": "检查三连获胜",
      "ops": [
        {
          "op": "branch",
          "if": {"call": ["check_five_in_row", {"var": "$state"}, {"get": ["$env", "lastPlacedCell"]}]},
          "then": [
            {"op": "set", "path": "state.env.winner", "value": {"get": ["$env", "lastActor"]}},
            {"op": "set", "path": "state.env.phase", "value": {"const": "game_over"}}
          ],
          "else": []
        }
      ]
    },
    "do_place_and_check": {
      "description": "完整落子流程: 放置 → 淘汰 → 判胜 → 切换回合",
      "ops": [
        {"op": "callEffect", "effectRef": "do_place"},
        {"op": "callEffect", "effectRef": "do_evict_oldest"},
        {"op": "branch",
          "if": {"not": {"eq": [{"get": ["$env", "phase"]}, {"const": "game_over"}]}},
          "then": [
            {"op": "callEffect", "effectRef": "do_check_winner"},
            {"op": "branch",
              "if": {"not": {"eq": [{"get": ["$env", "phase"]}, {"const": "game_over"}]}},
              "then": [{"op": "callEffect", "effectRef": "switch_turn"}]
            }
          ]
        }
      ]
    },
    "switch_turn": {
      "description": "切换回合",
      "ops": [
        {
          "op": "set",
          "path": "state.env.turn.currentPlayerId",
          "value": {
            "if": {
              "cond": {"eq": [{"get": ["$env.turn", "currentPlayerId"]}, {"const": "p_black"}]},
              "then": {"const": "p_white"},
              "else": {"const": "p_black"}
            }
          }
        },
        {"op": "set", "path": "state.env.phase", "value": {"const": "playing"}}
      ]
    }
  },
  "phases": [
    {
      "id": "playing",
      "actions": ["place_piece"],
      "description": "玩家回合: 在空格落子"
    }
  ],
  "terminal": [
    {
      "id": "three_in_row",
      "condition": {"eq": [{"get": ["$env", "phase"]}, {"const": "game_over"}]}
    },
    {
      "id": "board_full",
      "condition": {
        "and": [
          {"eq": [{"get": ["$env", "phase"]}, {"const": "playing"}]},
          {"eq": [{"count": {"query": {"type": "board_cell", "where": {"eq": [{"get": ["$node", "props.occupant"]}, {"const": null}]}}}}, {"const": 0}]}
        ]
      }
    }
  ],
  "utility": [
    {"player": "p_black", "value": {"const": 1}, "when": {"eq": [{"get": ["$env", "winner"]}, {"const": "p_black"}]}},
    {"player": "p_black", "value": {"const": -1}, "when": {"eq": [{"get": ["$env", "winner"]}, {"const": "p_white"}]}},
    {"player": "p_black", "value": {"const": 0}, "when": {"eq": [{"get": ["$env", "winner"]}, {"const": null}]}},
    {"player": "p_white", "value": {"const": 1}, "when": {"eq": [{"get": ["$env", "winner"]}, {"const": "p_white"}]}},
    {"player": "p_white", "value": {"const": -1}, "when": {"eq": [{"get": ["$env", "winner"]}, {"const": "p_black"}]}},
    {"player": "p_white", "value": {"const": 0}, "when": {"eq": [{"get": ["$env", "winner"]}, {"const": null}]}}
  ],
  "functions": {
    "check_five_in_row": {
      "name": "check_five_in_row",
      "args": [{"name": "state", "type": "StateGraph"}, {"name": "cellId", "type": "string"}],
      "returns": "boolean",
      "pure": true,
      "solverSafe": true,
      "description": "检查从指定格子出发是否有 N 连 (N=win_length)"
    }
  }
}
