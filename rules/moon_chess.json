{
  "meta": {
    "gameId": "moon_chess",
    "version": "5.0.0",
    "description": "3×3 board, 3 pieces per player, FIFO eviction, three-in-a-row wins"
  },
  "players": [
    "p_black",
    "p_white"
  ],
  "groundState": {
    "board": {
      "type": "array",
      "length": {
        "expr": "board_size * board_size"
      },
      "element": "player_id?"
    },
    "pieceOrder": {
      "type": "array",
      "mutable": true,
      "element": {
        "cell_id": "string",
        "player_id": "string"
      }
    },
    "env": {
      "type": "env",
      "fields": {
        "turn": {
          "type": "player_id",
          "initial": "p_black"
        },
        "round": {
          "type": "int",
          "initial": 0
        },
        "phase": {
          "type": "string",
          "initial": "playing"
        },
        "winner": {
          "type": "player_id?",
          "initial": null
        },
        "lastPlacedCell": {
          "type": "string?",
          "initial": null
        },
        "lastActor": {
          "type": "player_id?",
          "initial": null
        },
        "lastPlacedIndex": {
          "type": "int",
          "initial": 0
        }
      }
    }
  },
  "derivedViews": {
    "cell": {
      "from": {
        "array": "board",
        "type": "grid",
        "cols": {
          "const": 3
        }
      },
      "fields": {
        "id": {
          "template": "cell_{$row}_{$col}"
        },
        "occupant": {
          "get": [
            "$self",
            "value"
          ]
        },
        "x": {
          "var": "$col"
        },
        "y": {
          "var": "$row"
        }
      }
    },
    "player": {
      "from": {
        "type": "literal",
        "list": {
          "var": "$players"
        }
      },
      "fields": {
        "id": {
          "var": "$self.value.id"
        }
      }
    }
  },
  "constants": {
    "board_size": 3,
    "win_length": 3,
    "max_pieces": 3,
    "dirs": [
      {
        "dr": 0,
        "dc": 1
      },
      {
        "dr": 1,
        "dc": 0
      },
      {
        "dr": 1,
        "dc": 1
      },
      {
        "dr": 1,
        "dc": -1
      }
    ]
  },
  "queries": {
    "empty_cells": {
      "view": "cell",
      "filter": {
        "eq": [
          {
            "get": [
              "$node",
              "occupant"
            ]
          },
          {
            "const": null
          }
        ]
      }
    }
  },
  "actions": [
    {
      "id": "place_piece",
      "type": "move",
      "phases": [
        "playing"
      ],
      "actor": {
        "var": "$env.turn"
      },
      "params": {
        "cell": {
          "view": "cell",
          "domain": {
            "ref": "empty_cells"
          }
        }
      },
      "legal": {
        "const": true
      },
      "effectRef": "do_place_and_check",
      "canonicalKey": {
        "template": "place:{$cell.x},{$cell.y}"
      }
    }
  ],
  "effectors": {
    "do_place": {
      "description": "Place piece + record cell order",
      "ops": [
        {
          "op": "setIndex",
          "array": "board",
          "at": {
            "expr": "$cell.y * board_size + $cell.x"
          },
          "value": {
            "var": "$env.turn"
          }
        },
        {
          "op": "append",
          "array": "pieceOrder",
          "value": {
            "cell_id": {
              "get": [
                "$cell",
                "id"
              ]
            },
            "player_id": {
              "var": "$env.turn"
            }
          }
        },
        {
          "op": "setEnv",
          "key": "lastPlacedCell",
          "value": {
            "get": [
              "$cell",
              "id"
            ]
          }
        },
        {
          "op": "setEnv",
          "key": "lastPlacedIndex",
          "value": {
            "expr": "$cell.y * board_size + $cell.x"
          }
        },
        {
          "op": "setEnv",
          "key": "lastActor",
          "value": {
            "var": "$env.turn"
          }
        },
        {
          "op": "inc",
          "key": "round",
          "by": {
            "const": 1
          }
        }
      ]
    },
    "do_evict_oldest": {
      "description": "FIFO eviction — remove oldest piece beyond max",
      "ops": [
        {
          "op": "trimByKey",
          "array": "pieceOrder",
          "max": {
            "const": 3
          },
          "key": "player_id",
          "value": {
            "var": "$env.lastActor"
          },
          "onEvict": [
            {
              "op": "setIndex",
              "array": "board",
              "at": {
                "var": "evicted_index"
              },
              "value": {
                "const": null
              }
            }
          ]
        }
      ]
    },
    "do_check_winner": {
      "description": "Check for three-in-a-row",
      "ops": [
        {
          "op": "branch",
          "if": {
            "any": {
              "list": {
                "var": "$constants.dirs"
              },
              "as": "$d",
              "where": {
                "any": {
                  "list": {
                    "range": {
                      "from": 0,
                      "to": {
                        "var": "$constants.win_length"
                      }
                    }
                  },
                  "as": "$k",
                  "where": {
                    "all": {
                      "list": {
                        "range": {
                          "from": 0,
                          "to": {
                            "var": "$constants.win_length"
                          }
                        }
                      },
                      "as": "$j",
                      "where": {
                        "and": [
                          {
                            "and": [
                              {
                                "gte": [
                                  {
                                    "expr": "$env.lastPlacedIndex // board_size + (j - k) * d.dr"
                                  },
                                  {
                                    "const": 0
                                  }
                                ]
                              },
                              {
                                "lt": [
                                  {
                                    "expr": "$env.lastPlacedIndex // board_size + (j - k) * d.dr"
                                  },
                                  {
                                    "var": "$constants.board_size"
                                  }
                                ]
                              },
                              {
                                "gte": [
                                  {
                                    "expr": "$env.lastPlacedIndex % board_size + (j - k) * d.dc"
                                  },
                                  {
                                    "const": 0
                                  }
                                ]
                              },
                              {
                                "lt": [
                                  {
                                    "expr": "$env.lastPlacedIndex % board_size + (j - k) * d.dc"
                                  },
                                  {
                                    "var": "$constants.board_size"
                                  }
                                ]
                              }
                            ]
                          },
                          {
                            "eq": [
                              {
                                "at": [
                                  {
                                    "var": "$board"
                                  },
                                  {
                                    "expr": "($env.lastPlacedIndex // board_size + (j - k) * d.dr) * board_size + $env.lastPlacedIndex % board_size + (j - k) * d.dc"
                                  }
                                ]
                              },
                              {
                                "var": "$env.lastActor"
                              }
                            ]
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "then": [
            {
              "op": "setEnv",
              "key": "winner",
              "value": {
                "var": "$env.lastActor"
              }
            },
            {
              "op": "setEnv",
              "key": "phase",
              "value": {
                "const": "game_over"
              }
            }
          ],
          "else": []
        }
      ]
    },
    "do_place_and_check": {
      "description": "Complete place flow: place → evict → check winner → switch turn",
      "ops": [
        {
          "op": "callEffect",
          "effectRef": "do_place"
        },
        {
          "op": "callEffect",
          "effectRef": "do_evict_oldest"
        },
        {
          "op": "branch",
          "if": {
            "neq": [
              {
                "get": [
                  "$env",
                  "phase"
                ]
              },
              {
                "const": "game_over"
              }
            ]
          },
          "then": [
            {
              "op": "callEffect",
              "effectRef": "do_check_winner"
            },
            {
              "op": "branch",
              "if": {
                "neq": [
                  {
                    "get": [
                      "$env",
                      "phase"
                    ]
                  },
                  {
                    "const": "game_over"
                  }
                ]
              },
              "then": [
                {
                  "op": "callEffect",
                  "effectRef": "switch_turn"
                }
              ]
            }
          ]
        }
      ]
    },
    "switch_turn": {
      "description": "Switch to the other player",
      "ops": [
        {
          "op": "setEnv",
          "key": "turn",
          "value": {
            "switch": [
              {
                "case": "p_black",
                "then": "p_white"
              },
              {
                "case": "p_white",
                "then": "p_black"
              }
            ],
            "input": {
              "var": "$env.turn"
            }
          }
        },
        {
          "op": "setEnv",
          "key": "phase",
          "value": {
            "const": "playing"
          }
        }
      ]
    }
  },
  "phases": [
    {
      "id": "playing",
      "actions": [
        "place_piece"
      ],
      "description": "Player's turn: place a piece on an empty cell"
    }
  ],
  "visibility": {
    "default": "public"
  },
  "terminal": [
    {
      "id": "three_in_row",
      "condition": {
        "neq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          {
            "const": null
          }
        ]
      }
    },
    {
      "id": "max_rounds",
      "condition": {
        "gte": [
          {
            "get": [
              "$env",
              "round"
            ]
          },
          {
            "const": 50
          }
        ]
      }
    }
  ],
  "utility": [
    {
      "player": "p_black",
      "value": 1,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          "p_black"
        ]
      }
    },
    {
      "player": "p_black",
      "value": -1,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          "p_white"
        ]
      }
    },
    {
      "player": "p_black",
      "value": 0,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          null
        ]
      }
    },
    {
      "player": "p_white",
      "value": 1,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          "p_white"
        ]
      }
    },
    {
      "player": "p_white",
      "value": -1,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          "p_black"
        ]
      }
    },
    {
      "player": "p_white",
      "value": 0,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          null
        ]
      }
    }
  ]
}