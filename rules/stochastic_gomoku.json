{
  "meta": {
    "gameId": "stochastic_gomoku",
    "version": "5.0.0",
    "description": "Gomoku on configurable board with 50% vanish chance after each move"
  },
  "players": [
    "p_black",
    "p_white"
  ],
  "groundState": {
    "board": {
      "type": "array",
      "length": {
        "expr": "board_size * board_size"
      },
      "element": "player_id?"
    },
    "env": {
      "type": "env",
      "fields": {
        "turn": {
          "type": "player_id",
          "initial": "p_black"
        },
        "round": {
          "type": "int",
          "initial": 0
        },
        "phase": {
          "type": "string",
          "initial": "playing"
        },
        "winner": {
          "type": "player_id?",
          "initial": null
        },
        "lastPlacedCell": {
          "type": "string?",
          "initial": null
        },
        "lastActor": {
          "type": "player_id?",
          "initial": null
        },
        "lastAction": {
          "type": "string?",
          "initial": null
        },
        "lastPlacedIndex": {
          "type": "int",
          "initial": 0
        }
      }
    }
  },
  "derivedViews": {
    "cell": {
      "from": {
        "array": "board",
        "type": "grid",
        "cols": {
          "var": "$constants.board_size"
        }
      },
      "fields": {
        "id": {
          "template": "cell_{$row}_{$col}"
        },
        "occupant": {
          "get": [
            "$self",
            "value"
          ]
        },
        "x": {
          "var": "$col"
        },
        "y": {
          "var": "$row"
        }
      }
    },
    "player": {
      "from": {
        "type": "literal",
        "list": {
          "var": "$players"
        }
      },
      "fields": {
        "id": {
          "var": "$self.value.id"
        }
      }
    }
  },
  "constants": {
    "board_size": 9,
    "vanish_probability": 0.5,
    "win_length": 5
  },
  "queries": {
    "empty_cells": {
      "view": "cell",
      "filter": {
        "eq": [
          {
            "get": [
              "$node",
              "occupant"
            ]
          },
          {
            "const": null
          }
        ]
      }
    }
  },
  "actions": [
    {
      "id": "place_stone",
      "type": "move",
      "phases": [
        "playing"
      ],
      "actor": {
        "var": "$env.turn"
      },
      "params": {
        "cell": {
          "view": "cell",
          "domain": {
            "ref": "empty_cells"
          }
        }
      },
      "legal": {
        "const": true
      },
      "effectRef": "do_place",
      "canonicalKey": {
        "template": "place:{$cell.x},{$cell.y}"
      }
    }
  ],
  "effectors": {
    "do_place": {
      "description": "Place stone + enter vanish check phase",
      "ops": [
        {
          "op": "setIndex",
          "array": "board",
          "at": {
            "expr": "$cell.y * board_size + $cell.x"
          },
          "value": {
            "var": "$env.turn"
          }
        },
        {
          "op": "setEnv",
          "key": "lastPlacedCell",
          "value": {
            "get": [
              "$cell",
              "id"
            ]
          }
        },
        {
          "op": "setEnv",
          "key": "lastPlacedIndex",
          "value": {
            "expr": "$cell.y * board_size + $cell.x"
          }
        },
        {
          "op": "setEnv",
          "key": "lastActor",
          "value": {
            "var": "$env.turn"
          }
        },
        {
          "op": "setEnv",
          "key": "phase",
          "value": {
            "const": "vanish_check"
          }
        },
        {
          "op": "inc",
          "key": "round",
          "by": {
            "const": 1
          }
        }
      ]
    },
    "do_vanish": {
      "description": "Vanish the last placed piece",
      "ops": [
        {
          "op": "setIndex",
          "array": "board",
          "at": {
            "var": "$env.lastPlacedIndex"
          },
          "value": {
            "const": null
          }
        },
        {
          "op": "setEnv",
          "key": "lastAction",
          "value": {
            "const": "vanished"
          }
        },
        {
          "op": "callEffect",
          "effectRef": "switch_turn"
        }
      ]
    },
    "do_keep": {
      "description": "Keep the piece and check for win",
      "ops": [
        {
          "op": "setEnv",
          "key": "lastAction",
          "value": {
            "const": "kept"
          }
        },
        {
          "op": "branch",
          "if": {
            "call": [
              "check_line",
              {
                "var": "$state"
              },
              {
                "var": "$env.lastActor"
              },
              {
                "var": "$constants.win_length"
              }
            ]
          },
          "then": [
            {
              "op": "setEnv",
              "key": "winner",
              "value": {
                "var": "$env.lastActor"
              }
            },
            {
              "op": "setEnv",
              "key": "phase",
              "value": {
                "const": "game_over"
              }
            }
          ],
          "else": [
            {
              "op": "callEffect",
              "effectRef": "switch_turn"
            }
          ]
        }
      ]
    },
    "switch_turn": {
      "description": "Switch to the other player",
      "ops": [
        {
          "op": "setEnv",
          "key": "turn",
          "value": {
            "switch": [
              {
                "case": "p_black",
                "then": "p_white"
              },
              {
                "case": "p_white",
                "then": "p_black"
              }
            ],
            "input": {
              "var": "$env.turn"
            }
          }
        },
        {
          "op": "setEnv",
          "key": "phase",
          "value": {
            "const": "playing"
          }
        }
      ]
    }
  },
  "chance": [
    {
      "id": "vanish",
      "phases": [
        "vanish_check"
      ],
      "probability": {
        "explicit": [
          {
            "outcome": "vanish",
            "prob": 0.5
          },
          {
            "outcome": "keep",
            "prob": 0.5
          }
        ]
      },
      "effectMap": {
        "vanish": "do_vanish",
        "keep": "do_keep"
      },
      "canonicalKey": {
        "template": "chance:{outcome}"
      }
    }
  ],
  "phases": [
    {
      "id": "playing",
      "actions": [
        "place_stone"
      ],
      "description": "Player's turn: place a stone on an empty cell"
    },
    {
      "id": "vanish_check",
      "actions": [],
      "description": "Random check: last placed stone may vanish"
    }
  ],
  "visibility": {
    "default": "public"
  },
  "terminal": [
    {
      "id": "five_in_row",
      "condition": {
        "neq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          {
            "const": null
          }
        ]
      }
    },
    {
      "id": "board_full",
      "condition": {
        "and": [
          {
            "eq": [
              {
                "get": [
                  "$env",
                  "phase"
                ]
              },
              {
                "const": "playing"
              }
            ]
          },
          {
            "eq": [
              {
                "count": {
                  "query": {
                    "view": "cell",
                    "where": {
                      "eq": [
                        {
                          "get": [
                            "$node",
                            "occupant"
                          ]
                        },
                        {
                          "const": null
                        }
                      ]
                    }
                  }
                }
              },
              {
                "const": 0
              }
            ]
          }
        ]
      }
    }
  ],
  "utility": [
    {
      "player": "p_black",
      "value": 1,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          "p_black"
        ]
      }
    },
    {
      "player": "p_black",
      "value": -1,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          "p_white"
        ]
      }
    },
    {
      "player": "p_black",
      "value": 0,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          null
        ]
      }
    },
    {
      "player": "p_white",
      "value": 1,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          "p_white"
        ]
      }
    },
    {
      "player": "p_white",
      "value": -1,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          "p_black"
        ]
      }
    },
    {
      "player": "p_white",
      "value": 0,
      "when": {
        "eq": [
          {
            "get": [
              "$env",
              "winner"
            ]
          },
          null
        ]
      }
    }
  ],
  "functions": {
    "check_line": {
      "description": "Check N-in-a-row for a given player",
      "solverSafe": true,
      "pure": true
    }
  }
}